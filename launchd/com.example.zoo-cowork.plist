<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Cowork poller: reads Cowork audit logs into ~/.zoo (bin/zoo-cowork.js).
       Template: copy this file, replace every YOUR_USERNAME and com.example with your
       own (launchd labels must be unique per machine), then:
         cp launchd/com.example.zoo-cowork.plist ~/Library/LaunchAgents/com.YOUR_USERNAME.zoo-cowork.plist
         launchctl load ~/Library/LaunchAgents/com.YOUR_USERNAME.zoo-cowork.plist
       `which node` gives the node path below if you're not sure of it. -->
  <key>Label</key>
  <string>com.example.zoo-cowork</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/.local/bin/node</string>
    <string>/Users/YOUR_USERNAME/Developer/zoo/bin/zoo-cowork.js</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/zoo-cowork.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/zoo-cowork.err.log</string>
</dict>
</plist>
